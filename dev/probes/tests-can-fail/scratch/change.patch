--- /dev/null
+++ b/apps/web/src/lib/retry.ts
@@ -0,0 +1,20 @@
+export type RetryOptions = { attempts?: number; baseMs?: number; sleep?: (ms: number) => Promise<void>; retryable?: (e: unknown) => boolean };
+
+export function backoff(attempt: number, baseMs: number, capMs = 30_000): number {
+  return Math.min(capMs, baseMs * 2 ** (attempt - 1));
+}
+
+export async function retry<T>(fn: () => Promise<T>, opts: RetryOptions = {}): Promise<T> {
+  const { attempts = 3, baseMs = 100, sleep = (ms) => new Promise((r) => setTimeout(r, ms)), retryable = () => true } = opts;
+  let last: unknown;
+  for (let attempt = 1; attempt <= attempts; attempt++) {
+    try {
+      return await fn();
+    } catch (e) {
+      last = e;
+      if (attempt === attempts || !retryable(e)) break;
+      await sleep(backoff(attempt, baseMs));
+    }
+  }
+  throw last;
+}
