diff --git a/apps/web/src/lib/money.ts b/apps/web/src/lib/money.ts
index 9e7bb68..95ab8aa 100644
--- a/apps/web/src/lib/money.ts
+++ b/apps/web/src/lib/money.ts
@@ -17,3 +17,17 @@ export function format(m: Money): string {
   const cents = String(abs % 100).padStart(2, '0');
   return `${sign}$${dollars}.${cents} ${m.currency}`;
 }
+
+export function multiply(m: Money, factor: number): Money {
+  return { cents: Math.round(m.cents * factor), currency: m.currency };
+}
+
+// Split an amount by ratios without losing a cent: remainders go to the earliest parts.
+export function allocate(m: Money, ratios: number[]): Money[] {
+  const total = ratios.reduce((a, b) => a + b, 0);
+  if (ratios.length === 0 || total <= 0) throw new RangeError('ratios must sum to more than zero');
+  const parts = ratios.map((r) => Math.floor((m.cents * r) / total));
+  let left = m.cents - parts.reduce((a, b) => a + b, 0);
+  for (let i = 0; left > 0; i = (i + 1) % parts.length, left--) parts[i]++;
+  return parts.map((cents) => ({ cents, currency: m.currency }));
+}
