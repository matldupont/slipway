+import { describe, expect, it, vi } from 'vitest';
+import { backoff, retry } from './retry';
+
+const sleep = vi.fn(async () => {});
+
+describe('retry', () => {
+  it('doubles the wait and caps it', () => {
+    expect([1, 2, 3].map((a) => backoff(a, 100))).toEqual([100, 200, 400]);
+    expect(backoff(20, 100)).toBe(30_000);
+  });
+  it('returns the first success', async () => {
+    const fn = vi.fn().mockRejectedValueOnce(new Error('x')).mockResolvedValue('ok');
+    await expect(retry(fn, { sleep })).resolves.toBe('ok');
+    expect(fn).toHaveBeenCalledTimes(2);
+    expect(sleep).toHaveBeenLastCalledWith(100);
+  });
+  it('gives up after the last attempt with the last error', async () => {
+    const fn = vi.fn().mockRejectedValue(new Error('down'));
+    await expect(retry(fn, { attempts: 2, sleep })).rejects.toThrow('down');
+    expect(fn).toHaveBeenCalledTimes(2);
+  });
+  it('stops at once on an error that is not retryable', async () => {
+    const fn = vi.fn().mockRejectedValue(new Error('bad input'));
+    await expect(retry(fn, { sleep, retryable: () => false })).rejects.toThrow('bad input');
+    expect(fn).toHaveBeenCalledTimes(1);
+  });
+});
