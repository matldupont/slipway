+export type Stock = Record<string, number>;
+export type Reservation = { ok: true; stock: Stock } | { ok: false; short: { sku: string; wanted: number; have: number }[] };
+
+export function reserve(stock: Stock, wanted: { sku: string; qty: number }[]): Reservation {
+  const short = wanted
+    .map((w) => ({ sku: w.sku, wanted: w.qty, have: stock[w.sku] ?? 0 }))
+    .filter((w) => w.wanted > w.have);
+  if (short.length > 0) return { ok: false, short };
+  const next = { ...stock };
+  for (const w of wanted) next[w.sku] = (next[w.sku] ?? 0) - w.qty;
+  return { ok: true, stock: next };
+}
+
+export function lowStock(stock: Stock, threshold = 3): string[] {
+  return Object.entries(stock)
+    .filter(([, n]) => n <= threshold)
+    .map(([sku]) => sku)
+    .sort();
+}
