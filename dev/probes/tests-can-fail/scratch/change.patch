diff --git a/apps/web/src/lib/search.ts b/apps/web/src/lib/search.ts
new file mode 100644
index 0000000..b6972c0
--- /dev/null
+++ b/apps/web/src/lib/search.ts
@@ -0,0 +1,17 @@
+import { slugify } from './slug';
+
+export type Item = { sku: string; name: string; tags: string[] };
+
+export function searchItems(items: Item[], query: string): Item[] {
+  const q = slugify(query);
+  if (q === '') return items;
+  const terms = q.split('-');
+  return items
+    .map((item) => {
+      const hay = [slugify(item.name), ...item.tags.map(slugify)];
+      const score = terms.reduce((n, t) => n + (hay.some((h) => h.includes(t)) ? 1 : 0), 0);
+      return { item, score };
+    })
+    .filter((r) => r.score === terms.length)
+    .map((r) => r.item);
+}
