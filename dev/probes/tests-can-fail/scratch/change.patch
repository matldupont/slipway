+export function phone(value: string): Result {
+  const digits = value.replace(/\D/g, '');
+  const national = digits.length === 11 && digits.startsWith('1') ? digits.slice(1) : digits;
+  if (national.length !== 10) return { ok: false, error: 'Phone number must have 10 digits' };
