@@ -0,0 +1,22 @@
+import { money, multiply, type Money } from './money';
+
+export type Code =
+  | { kind: 'percent'; code: string; percent: number; minimum?: Money }
+  | { kind: 'fixed'; code: string; off: Money; minimum?: Money };
+
+export type Applied = { total: Money; saved: Money; reason?: string };
+
+export function applyDiscount(subtotal: Money, code: Code | undefined): Applied {
+  const none = { total: subtotal, saved: money(0, subtotal.currency) };
+  if (!code) return none;
+  if (code.minimum && subtotal.cents < code.minimum.cents) {
+    return { ...none, reason: `Spend at least ${code.minimum.cents / 100} to use ${code.code}` };
+  }
+  if (code.kind === 'percent') {
+    if (code.percent <= 0 || code.percent > 100) return { ...none, reason: `${code.code} is not valid` };
+    const saved = multiply(subtotal, code.percent / 100);
+    return { total: money(subtotal.cents - saved.cents, subtotal.currency), saved };
+  }
+  const saved = money(Math.min(code.off.cents, subtotal.cents), subtotal.currency);
+  return { total: money(subtotal.cents - saved.cents, subtotal.currency), saved };
+}
