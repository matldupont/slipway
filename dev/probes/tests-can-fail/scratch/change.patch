@@ -0,0 +1,47 @@
+import { useState } from 'react';
+import { email, phone, postalCode, required, type Result } from '../lib/validate';
+
+export type Order = { name: string; email: string; phone: string; postalCode: string };
+const EMPTY: Order = { name: '', email: '', phone: '', postalCode: '' };
+
+export function validateOrder(o: Order): Partial<Record<keyof Order, string>> {
+  const checks: [keyof Order, Result][] = [
+    ['name', required('Name', o.name)],
+    ['email', email(o.email)],
+    ['phone', phone(o.phone)],
+    ['postalCode', postalCode(o.postalCode)],
+  ];
+  return Object.fromEntries(checks.flatMap(([k, r]) => (r.ok ? [] : [[k, r.error]])));
+}
+
+export function OrderForm({ onSubmit }: { onSubmit: (o: Order) => void }) {
+  const [order, setOrder] = useState(EMPTY);
+  const [errors, setErrors] = useState<Partial<Record<keyof Order, string>>>({});
+  const field = (key: keyof Order, label: string) => (
+    <label>
+      {label}
+      <input
+        value={order[key]}
+        aria-invalid={errors[key] ? true : undefined}
+        onChange={(e) => setOrder({ ...order, [key]: e.target.value })}
+      />
+      {errors[key] ? <span role="alert">{errors[key]}</span> : null}
+    </label>
+  );
+  return (
+    <form
+      onSubmit={(e) => {
+        e.preventDefault();
+        const found = validateOrder(order);
+        setErrors(found);
+        if (Object.keys(found).length === 0) onSubmit(order);
+      }}
+    >
+      {field('name', 'Name')}
+      {field('email', 'Email')}
+      {field('phone', 'Phone')}
+      {field('postalCode', 'Postal code')}
+      <button type="submit">Place order</button>
+    </form>
+  );
+}
