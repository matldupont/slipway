@@ -0,0 +1,28 @@
+import { describe, expect, it } from 'vitest';
+import { addLine, removeLine, subtotal, type Cart } from './cart';
+import { money } from './money';
+
+const tea = { sku: 'tea', name: 'Tea', unit: money(450), qty: 1 };
+const mug = { sku: 'mug', name: 'Mug', unit: money(1200), qty: 2 };
+
+describe('cart', () => {
+  it('adds a new line', () => {
+    expect(addLine({ lines: [] }, tea).lines).toEqual([tea]);
+  });
+  it('merges quantity for a known sku', () => {
+    const cart = addLine(addLine({ lines: [mug] }, tea), tea);
+    expect(cart.lines.find((l) => l.sku === 'tea')?.qty).toBe(2);
+    expect(cart.lines.find((l) => l.sku === 'mug')?.qty).toBe(2);
+    expect(cart.lines).toHaveLength(2);
+  });
+  it('rejects a zero quantity', () => {
+    expect(() => addLine({ lines: [] }, { ...tea, qty: 0 })).toThrow(RangeError);
+  });
+  it('removes by sku', () => {
+    expect(removeLine({ lines: [tea, mug] }, 'tea').lines).toEqual([mug]);
+  });
+  it('sums the subtotal', () => {
+    const cart: Cart = { lines: [tea, mug] };
+    expect(subtotal(cart)).toEqual(money(2850));
+  });
+});
diff --git a/apps/web/src/lib/cart.ts b/apps/web/src/lib/cart.ts
new file mode 100644
index 0000000..7cdbf0c
--- /dev/null
+++ b/apps/web/src/lib/cart.ts
@@ -0,0 +1,19 @@
+import { add, money, type Money } from './money';
+
+export type Line = { sku: string; name: string; unit: Money; qty: number };
+export type Cart = { lines: Line[] };
+
+export function addLine(cart: Cart, line: Line): Cart {
+  if (line.qty <= 0) throw new RangeError('qty must be positive');
+  const existing = cart.lines.find((l) => l.sku === line.sku);
+  if (!existing) return { lines: [...cart.lines, line] };
+  return { lines: cart.lines.map((l) => (l.sku === line.sku ? { ...l, qty: l.qty + line.qty } : l)) };
+}
+
+export function removeLine(cart: Cart, sku: string): Cart {
+  return { lines: cart.lines.filter((l) => l.sku !== sku) };
+}
+
+export function subtotal(cart: Cart): Money {
+  return cart.lines.reduce((sum, l) => add(sum, money(l.unit.cents * l.qty, l.unit.currency)), money(0));
+}
