diff --git a/apps/web/src/lib/paginate.ts b/apps/web/src/lib/paginate.ts
new file mode 100644
index 0000000..b9cc1c5
--- /dev/null
+++ b/apps/web/src/lib/paginate.ts
@@ -0,0 +1,9 @@
+export type Page<T> = { items: T[]; page: number; pages: number; hasNext: boolean; hasPrev: boolean };
+
+export function paginate<T>(all: T[], page: number, size: number): Page<T> {
+  if (size < 1) throw new RangeError('size must be at least 1');
+  const pages = Math.max(1, Math.ceil(all.length / size));
+  const p = Math.min(Math.max(1, page), pages);
+  const start = (p - 1) * size;
+  return { items: all.slice(start, start + size), page: p, pages, hasNext: p < pages, hasPrev: p > 1 };
+}
