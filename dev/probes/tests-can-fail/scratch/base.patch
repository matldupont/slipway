+import { format, type Money } from '../lib/money';
+
+export function PriceTag({ amount, strike }: { amount: Money; strike?: Money }) {
+  return (
+    <span className="price">
+      {strike && strike.cents > amount.cents ? <s data-testid="strike">{format(strike)}</s> : null}
+      <strong>{format(amount)}</strong>
+    </span>
+  );
+}
