@@ -0,0 +1,23 @@
+import { subtotal, type Cart } from '../lib/cart';
+import { PriceTag } from './PriceTag';
+
+export function CartSummary({ cart, onRemove }: { cart: Cart; onRemove: (sku: string) => void }) {
+  if (cart.lines.length === 0) return <p>Your cart is empty.</p>;
+  return (
+    <section aria-label="Cart">
+      <ul>
+        {cart.lines.map((l) => (
+          <li key={l.sku}>
+            {l.qty} × {l.name}
+            <button type="button" onClick={() => onRemove(l.sku)}>
+              Remove {l.name}
+            </button>
+          </li>
+        ))}
+      </ul>
+      <p>
+        Subtotal: <PriceTag amount={subtotal(cart)} />
+      </p>
+    </section>
+  );
+}
