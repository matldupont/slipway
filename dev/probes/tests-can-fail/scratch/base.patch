+import { describe, expect, it } from 'vitest';
+import { add, format, money } from './money';
+
+describe('money', () => {
+  it('rejects fractional cents', () => {
+    expect(() => money(1.5)).toThrow(RangeError);
+  });
+  it('adds same-currency amounts', () => {
+    expect(add(money(150), money(275))).toEqual({ cents: 425, currency: 'CAD' });
+  });
+  it('refuses to add across currencies', () => {
+    expect(() => add(money(1, 'CAD'), money(1, 'USD'))).toThrow('cannot add CAD to USD');
+  });
+  it('formats with two decimals and a sign', () => {
+    expect(format(money(-1205))).toBe('-$12.05 CAD');
+    expect(format(money(7))).toBe('$0.07 CAD');
+  });
+});
