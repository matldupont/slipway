+export type Money = { cents: number; currency: string };
+
+export function money(cents: number, currency = 'CAD'): Money {
+  if (!Number.isInteger(cents)) throw new RangeError('cents must be an integer');
+  return { cents, currency };
+}
+
+export function add(a: Money, b: Money): Money {
+  if (a.currency !== b.currency) throw new Error(`cannot add ${a.currency} to ${b.currency}`);
+  return { cents: a.cents + b.cents, currency: a.currency };
+}
+
+export function format(m: Money): string {
+  const sign = m.cents < 0 ? '-' : '';
+  const abs = Math.abs(m.cents);
+  const dollars = Math.floor(abs / 100);
+  const cents = String(abs % 100).padStart(2, '0');
+  return `${sign}$${dollars}.${cents} ${m.currency}`;
+}
