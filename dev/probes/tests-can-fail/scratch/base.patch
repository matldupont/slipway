+import { describe, expect, it } from 'vitest';
+import { daysBetween, isWeekend, startOfDay } from './dates';
+
+describe('dates', () => {
+  it('truncates to the UTC day', () => {
+    expect(startOfDay(new Date('2026-03-04T17:45:00Z')).toISOString()).toBe('2026-03-04T00:00:00.000Z');
+  });
+  it('counts whole days, either direction', () => {
+    expect(daysBetween(new Date('2026-03-01T23:00:00Z'), new Date('2026-03-04T01:00:00Z'))).toBe(3);
+    expect(daysBetween(new Date('2026-03-04T01:00:00Z'), new Date('2026-03-01T23:00:00Z'))).toBe(-3);
+  });
+  it('knows a weekend', () => {
+    expect(isWeekend(new Date('2026-03-07T12:00:00Z'))).toBe(true);
+    expect(isWeekend(new Date('2026-03-08T12:00:00Z'))).toBe(true);
+    expect(isWeekend(new Date('2026-03-09T12:00:00Z'))).toBe(false);
+  });
+});
