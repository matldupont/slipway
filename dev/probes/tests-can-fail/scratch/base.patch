@@ -0,0 +1,14 @@
+export type Result = { ok: true } | { ok: false; error: string };
+
+export function email(value: string): Result {
+  const v = value.trim();
+  if (v === '') return { ok: false, error: 'Email is required' };
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return { ok: false, error: 'Email is not valid' };
+  return { ok: true };
+}
+
+export function postalCode(value: string): Result {
+  const v = value.trim().toUpperCase();
+  if (!/^[A-Z]\d[A-Z] ?\d[A-Z]\d$/.test(v)) return { ok: false, error: 'Postal code is not valid' };
+  return { ok: true };
+}
