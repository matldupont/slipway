{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git stash pop:*)",
      "Bash(git stash drop:*)",
      "Bash(git checkout --:*)",
      "Bash(git reset --hard:*)",
      "Bash(*sync --apply*)",
      "Bash(*sync*--apply*)",
      "Edit(**/biome.json)",
      "Write(**/biome.json)",
      "Edit(**/biome.jsonc)",
      "Write(**/biome.jsonc)",
      "Edit(**/tsconfig*.json)",
      "Write(**/tsconfig*.json)",
      "Edit(**/eslint.config.*)",
      "Write(**/eslint.config.*)",
      "Edit(**/.eslintrc*)",
      "Write(**/.eslintrc*)",
      "Edit(**/.prettierrc*)",
      "Write(**/.prettierrc*)",
      "Edit(**/prettier.config.*)",
      "Write(**/prettier.config.*)",
      "Edit(**/vitest.config.*)",
      "Write(**/vitest.config.*)",
      "Edit(**/vite.config.*)",
      "Write(**/vite.config.*)",
      "Edit(**/.oxlintrc*)",
      "Write(**/.oxlintrc*)",
      "Edit(**/oxlint.config.*)",
      "Write(**/oxlint.config.*)",
      "Edit(**/.github/workflows/**)",
      "Write(**/.github/workflows/**)",
      "Edit(**/ci/**)",
      "Write(**/ci/**)",
      "Edit(**/process/harness/**)",
      "Write(**/process/harness/**)",
      "Edit(**/.claude/settings*.json)",
      "Write(**/.claude/settings*.json)",
      "Edit(**/.slipway/**)",
      "Write(**/.slipway/**)",
      "Edit(**/.claude/**)",
      "Write(**/.claude/**)",
      "Edit(**/AGENT.md)",
      "Write(**/AGENT.md)",
      "Edit(**/CLAUDE.md)",
      "Write(**/CLAUDE.md)",
      "Edit(**/process/slipway-rules.md)",
      "Write(**/process/slipway-rules.md)",
      "Edit(**/process/intake.md)",
      "Write(**/process/intake.md)",
      "Edit(**/dev/skill-configuration.md)",
      "Write(**/dev/skill-configuration.md)",
      "Edit(**/dev/ownership.yaml)",
      "Write(**/dev/ownership.yaml)",
      "Edit(**/scripts/new-project.mjs)",
      "Write(**/scripts/new-project.mjs)",
      "Edit(**/.npmrc)",
      "Write(**/.npmrc)",
      "Edit(**/.pnpmfile.cjs)",
      "Write(**/.pnpmfile.cjs)",
      "Edit(**/pnpm-workspace.yaml)",
      "Write(**/pnpm-workspace.yaml)",
      "Edit(**/node_modules/**)",
      "Write(**/node_modules/**)",
      "Edit(**/.envrc)",
      "Write(**/.envrc)",
      "Edit(**/mise.toml)",
      "Write(**/mise.toml)",
      "Edit(**/.mise.toml)",
      "Write(**/.mise.toml)",
      "Edit(**/package.yaml)",
      "Write(**/package.yaml)",
      "Edit(**/package.json5)",
      "Write(**/package.json5)",
      "Edit(**/mise.*.toml)",
      "Write(**/mise.*.toml)",
      "Edit(**/.mise.*.toml)",
      "Write(**/.mise.*.toml)",
      "Edit(**/.config/mise.toml)",
      "Write(**/.config/mise.toml)",
      "Edit(**/.config/mise.*.toml)",
      "Write(**/.config/mise.*.toml)",
      "Edit(**/.config/mise/**)",
      "Write(**/.config/mise/**)",
      "Edit(**/mise/*.toml)",
      "Write(**/mise/*.toml)",
      "Edit(**/.mise/*.toml)",
      "Write(**/.mise/*.toml)",
      "Bash(git remote set-head:*)",
      "Bash(git update-ref:*)",
      "Bash(git replace:*)",
      "Bash(*refs/remotes/origin*)"
    ],
    "allow": [
      "Bash(git stash list:*)",
      "Bash(git stash apply:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh -c \"$(git -C \"$CLAUDE_PROJECT_DIR\" cat-file blob refs/remotes/origin/HEAD:process/harness/hooks/base-guard.sh 2>/dev/null || echo 'echo \"{\\\"systemMessage\\\":\\\"base-guard: origin/HEAD holds no process/harness/hooks/base-guard.sh so no hook ran.\\\"}\"')\" base-guard session-state.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh -c \"$(git -C \"$CLAUDE_PROJECT_DIR\" cat-file blob refs/remotes/origin/HEAD:process/harness/hooks/base-guard.sh 2>/dev/null || echo true)\" base-guard intake-reminder.sh" },
          { "type": "command", "command": "sh -c \"$(git -C \"$CLAUDE_PROJECT_DIR\" cat-file blob refs/remotes/origin/HEAD:process/harness/hooks/base-guard.sh 2>/dev/null || echo true)\" base-guard lessons-first.sh" },
          { "type": "command", "command": "sh -c \"$(git -C \"$CLAUDE_PROJECT_DIR\" cat-file blob refs/remotes/origin/HEAD:process/harness/hooks/base-guard.sh 2>/dev/null || echo true)\" base-guard absence-search.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh -c \"$(git -C \"$CLAUDE_PROJECT_DIR\" cat-file blob refs/remotes/origin/HEAD:process/harness/hooks/base-guard.sh 2>/dev/null || echo 'echo \"{\\\"systemMessage\\\":\\\"base-guard: origin/HEAD holds no process/harness/hooks/base-guard.sh so no hook ran.\\\"}\"')\" base-guard stop-verify.sh", "timeout": 600 }
        ]
      }
    ]
  }
}
