{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git stash pop:*)",
      "Bash(git stash drop:*)",
      "Bash(git checkout --:*)",
      "Bash(git reset --hard:*)",
      "Bash(*sync --apply*)",
      "Bash(*sync*--apply*)",
      "Edit(**/biome.json)",
      "Edit(**/biome.jsonc)",
      "Edit(**/tsconfig*.json)",
      "Edit(**/eslint.config.*)",
      "Edit(**/.eslintrc*)",
      "Edit(**/.prettierrc*)",
      "Edit(**/prettier.config.*)",
      "Edit(**/vitest.config.*)",
      "Edit(**/vite.config.*)",
      "Edit(**/.oxlintrc*)",
      "Edit(**/oxlint.config.*)",
      "Edit(**/.github/workflows/**)",
      "Edit(**/ci/**)",
      "Edit(**/process/harness/**)",
      "Edit(**/.claude/settings*.json)",
      "Edit(**/.slipway/**)",
      "Write(**/.slipway/**)"
    ],
    "allow": [
      "Bash(git stash list:*)",
      "Bash(git stash apply:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/process/harness/hooks/session-state.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/process/harness/hooks/intake-reminder.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/process/harness/hooks/lessons-first.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/process/harness/hooks/absence-search.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/process/harness/hooks/stop-verify.sh", "timeout": 600 }
        ]
      }
    ]
  }
}
